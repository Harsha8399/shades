# Shades Trading Platform - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Angel One SmartAPI Credentials
# Get these from: https://smartapi.angelone.in
# =============================================================================

# Your SmartAPI Key (from SmartAPI dashboard)
ANGELONE_API_KEY=your_api_key_here

# Your Angel One Client ID (login ID)
ANGELONE_CLIENT_ID=your_client_id_here

# Your Angel One login password
ANGELONE_PASSWORD=your_password_here

# TOTP Secret for 2FA (from SmartAPI > TOTP setup)
# This is the secret key, NOT the 6-digit code
ANGELONE_TOTP_SECRET=your_totp_secret_here

# =============================================================================
# Upstox API Credentials (Alternative to Angel One)
# Get these from: https://developer.upstox.com
# =============================================================================

# UPSTOX_API_KEY=your_upstox_api_key
# UPSTOX_API_SECRET=your_upstox_secret
# UPSTOX_REDIRECT_URI=http://localhost:3000/callback
# UPSTOX_ACCESS_TOKEN=your_access_token_after_oauth

# =============================================================================
# Database Configuration
# =============================================================================

# Path to SQLite database file
DB_PATH=./data/trades.db

# =============================================================================
# API Server Configuration
# =============================================================================

# Port for the Express API server
PORT=3001

# =============================================================================
# Trading Configuration
# =============================================================================

# Initial capital for paper trading (in INR)
INITIAL_CAPITAL=100000

# Maximum risk per trade (as decimal, e.g., 0.02 = 2%)
MAX_RISK_PER_TRADE=0.02

# Market segment: NSE_EQUITY, NSE_FNO, or MCX
MARKET_SEGMENT=NSE_EQUITY

# =============================================================================
# Logging
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable file logging
LOG_TO_FILE=true

# Log directory
LOG_DIR=./logs

